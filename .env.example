# Copy to .env.local and fill in. Everything is optional: without a key the site
# still works and the AI features fall back to WhatsApp / manual flows.

# Claude API key from https://platform.claude.com/ (powers Digi chat, AI audit, lead scoring)
ANTHROPIC_API_KEY=sk-ant-...
# DIGI_MODEL=claude-opus-5-5

# Where new leads are sent (any of these). The lead is AI-scored before sending.
# Make / Zapier / n8n / Pabbly / Slack-compatible webhook - receives JSON
LEAD_WEBHOOK_URL=
# Email alerts via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=hello@digitroot.in
LEAD_EMAIL_FROM=Digitroot Leads <leads@digitroot.in>

# Optional: Google PageSpeed Insights API key for real Core Web Vitals in the AI audit
PAGESPEED_API_KEY=

# Public site URL (used for sitemap, canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL=https://www.digitroot.in

# ---- PPC & analytics tracking (all optional, all public) ----
# Google Tag Manager container (recommended: manage GA4 / Ads / Meta tags inside GTM).
# The site pushes `generate_lead` (form submits) and `contact_click` (call / WhatsApp taps) to the dataLayer.
NEXT_PUBLIC_GTM_ID=
# Or load gtag.js directly (ignored when GTM is set):
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GADS_ID=
# Google Ads conversion labels (from Ads > Goals > Conversions > tag setup)
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
# Meta Pixel (fires Lead and Contact events)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=
